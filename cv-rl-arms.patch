@@ -0,0 +1,31 @@
+"""Run from the repo root: python3 -m unittest motion.tests.test_arms -v"""
+import unittest
+
+from motion.control.arm_params import motion_for_emotion
+from motion.control.emotion_arms import EmotionArms
+from motion.drivers.arm_link import ArmLink
+
+
+class TestArms(unittest.TestCase):
+    def test_happy_is_fast_large_and_out_of_phase(self):
+        happy = motion_for_emotion("happy")
+        sad = motion_for_emotion("sad")
+        self.assertEqual(happy.phase_offset_deg, 180.0)
+        self.assertEqual(sad.phase_offset_deg, 0.0)
+        self.assertLess(happy.period_s, sad.period_s)
+        self.assertGreater(happy.amplitude, sad.amplitude)
+
+    def test_apply_sends_a_line_the_arduino_can_parse(self):
+        link = ArmLink()
+        profile = EmotionArms(link).apply("sad")
+        self.assertEqual(profile.phase_offset_deg, 0.0)
+        self.assertTrue(link.last_line.startswith("ARM "))
+        parts = link.last_line.split()
+        self.assertEqual(parts[0], "ARM")
+        self.assertEqual(parts[4], "sad")
+        self.assertAlmostEqual(float(parts[1]), profile.period_s)
+        self.assertAlmostEqual(float(parts[3]), 0.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/perception/bridge.py b/perception/bridge.py
new file mode 100644
index 0000000..fbf6427
--- /dev/null
+++ b/perception/bridge.py
@@ -0,0 +1,55 @@
+"""Turn a live camera GroupReaction into the message the RL agent already learns from.
+
+The camera pipeline (perception.perception) and the bandit (shared.schemas) each
+have their own GroupReaction type. This is the only place that converts one into
+the other, so the agent can discourage a song and its genre from a real face.
+"""
+from __future__ import annotations
+
+import threading
+import time
+
+from shared.schemas.messages import GroupReaction, PersonReaction
+
+
+def to_shared(live, song_id: str | None = None) -> GroupReaction:
+    people = tuple(
+        PersonReaction(int(p.person_id), p.emotion, float(p.liking), float(p.confidence))
+        for p in live.people
+    )
+    return GroupReaction(
+        timestamp=float(live.timestamp),
+        song_id=song_id or live.song_id,
+        people=people,
+        group_liking=float(live.group_liking),
+        group_emotion=dict(live.group_emotion),
+    )
+
+
+class LiveCamera:
+    """Read whatever faces the camera has seen over the last sample_s seconds."""
+
+    def __init__(self, service, sample_s: float = 2.0):
+        self.service = service
+        self.sample_s = sample_s
+
+    def __call__(self, song_id: str) -> GroupReaction:
+        if self.sample_s > 0:
+            time.sleep(self.sample_s)
+        return to_shared(self.service.get_group_reaction(song_id), song_id)
+
+
+def start_camera(camera_index: int = 2, detector: str = "yunet"):
+    """Open the local camera (DroidCam) and keep feeding the perception service.
+
+    Returns the service. The preview window runs on a background thread; press q
+    in that window to stop it. DeepFace is imported only here, not at test time.
+    """
+    from perception.perception.api import build_service
+    from perception.perception.capture.local_camera import run_local_camera
+
+    service = build_service(detector=detector)
+    threading.Thread(
+        target=run_local_camera, args=(service, camera_index), daemon=True,
+    ).start()
+    return service
