+"""Run from the repo root: python3 -m unittest integration.tests.test_cv_to_rl -v"""
+import unittest
+
+from music.catalog.songs import SONGS
+from perception.bridge import to_shared
+from perception.emotion.fake_reaction import _reaction
+from rl.agent.bandit import BanditAgent
+from rl.agent.context import Context
+
+BY_ID = {s.song_id: s for s in SONGS}
+CTX = Context("event:party", "neutral")
+
+
+class _Person:
+    def __init__(self, emotion, liking, confidence=1.0):
+        self.person_id = 0
+        self.emotion = emotion
+        self.liking = liking
+        self.confidence = confidence
+
+
+class _Live:
+    def __init__(self, liking, emotion):
+        self.timestamp = 0.0
+        self.song_id = "s8"
+        self.people = [_Person(emotion, liking)]
+        self.group_liking = liking
+        self.group_emotion = {emotion: 1.0}
+
+
+class TestCameraFeedsTheBandit(unittest.TestCase):
+    def test_unhappy_camera_frame_discourages_song_and_genre(self):
+        agent = BanditAgent(seed=0)
+        song = BY_ID["s8"]  # hip-hop
+        reaction = to_shared(_Live(-0.8, "sad"), song.song_id)
+        self.assertLessEqual(reaction.group_liking, -0.2)
+        self.assertEqual(reaction.people[0].emotion, "sad")
+
+        before = agent.predict(song, CTX)
+        before_genre = agent.weights.get(("global", "genre:hip-hop"), 0.0)
+        agent.update(song, reaction, CTX)
+        self.assertLess(agent.predict(song, CTX), before)
+        self.assertLess(agent.weights[("global", "genre:hip-hop")], before_genre)
+
+    def test_keyboard_dislike_uses_the_same_update(self):
+        """The fake 'd' key and a sad camera frame are the same kind of reward."""
+        song = BY_ID["s1"]
+        keyboard = _reaction("s1", -1.0, "sad")
+        camera = to_shared(_Live(-1.0, "sad"), "s1")
+        a, b = BanditAgent(seed=1), BanditAgent(seed=1)
+        a.update(song, keyboard, CTX)
+        b.update(song, camera, CTX)
+        self.assertAlmostEqual(a.predict(song, CTX), b.predict(song, CTX))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/motion/control/arm_params.py b/motion/control/arm_params.py
new file mode 100644
index 0000000..1ae8c67
--- /dev/null
+++ b/motion/control/arm_params.py
@@ -0,0 +1,55 @@
+"""Arm oscillation, chosen from the listener's emotion.
+
+Both arms follow a sine around the center pose:
+
+    left  = amplitude * sin(2 * pi * t / period_s)
+    right = amplitude * sin(2 * pi * t / period_s + radians(phase_offset_deg))
+
+phase_offset_deg
+    0    both arms move together ("at the same time")
+    180  arms move opposite each other (out of phase)
+
+amplitude is a fraction of full travel, from 0.0 to 1.0.
+period_s is seconds for one full cycle. Smaller means faster.
+
+Edit the numbers in this file. Callers only look up a profile by emotion name.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class ArmProfile:
+    period_s: float
+    amplitude: float
+    phase_offset_deg: float
+
+
+# Happy: out of phase, fairly fast, large swing.
+HAPPY = ArmProfile(period_s=0.55, amplitude=0.85, phase_offset_deg=180.0)
+
+# Sad: in phase, much slower, small swing.
+SAD = ArmProfile(period_s=2.80, amplitude=0.22, phase_offset_deg=0.0)
+
+# Used when the camera sees nobody, or an emotion with no profile of its own.
+NEUTRAL = ArmProfile(period_s=1.40, amplitude=0.40, phase_offset_deg=0.0)
+
+# Starting points for the other emotions. Happy and sad are the ones specified.
+SURPRISED = ArmProfile(period_s=0.70, amplitude=0.70, phase_offset_deg=180.0)
+ANGRY = ArmProfile(period_s=0.90, amplitude=0.50, phase_offset_deg=180.0)
+BORED = ArmProfile(period_s=3.20, amplitude=0.15, phase_offset_deg=0.0)
+
+PROFILES: dict[str, ArmProfile] = {
+    "happy": HAPPY,
+    "surprised": SURPRISED,
+    "sad": SAD,
+    "angry": ANGRY,
+    "bored": BORED,
+    "neutral": NEUTRAL,
+}
+
+
+def motion_for_emotion(emotion: str) -> ArmProfile:
+    """Profile for this emotion. Unknown names fall back to NEUTRAL."""
+    return PROFILES.get(emotion, NEUTRAL)
diff --git a/motion/control/emotion_arms.py b/motion/control/emotion_arms.py
new file mode 100644
index 0000000..aed8b98
--- /dev/null
+++ b/motion/control/emotion_arms.py
@@ -0,0 +1,17 @@
+"""Apply the listener's emotion to the arms. Does not import music or perception."""
+from __future__ import annotations
+
+from motion.control.arm_params import ArmProfile, motion_for_emotion
+from motion.drivers.arm_link import ArmLink
+
+
+class EmotionArms:
+    def __init__(self, link: ArmLink | None = None):
+        self.link = link or ArmLink()
+        self.history: list[tuple[str, ArmProfile]] = []
+
+    def apply(self, emotion: str) -> ArmProfile:
+        profile = motion_for_emotion(emotion)
+        self.link.send(profile, emotion)
+        self.history.append((emotion, profile))
+        return profile
diff --git a/motion/drivers/arm_link.py b/motion/drivers/arm_link.py
new file mode 100644
index 0000000..3c382ff
--- /dev/null
+++ b/motion/drivers/arm_link.py
@@ -0,0 +1,40 @@
+"""Send the current arm profile to the Arduino over serial.
+
+Line format (one update per line):
+
+    ARM <period_s> <amplitude> <phase_offset_deg> <emotion>
+
+Example:
+
+    ARM 0.550 0.850 180.0 happy
+
+If port is None, the line is stored in last_line and nothing is sent.
+That is what tests and a laptop with no Arduino plugged in use.
+"""
+from __future__ import annotations
+
+from motion.control.arm_params import ArmProfile
+
+
+class ArmLink:
+    def __init__(self, port: str | None = None, baud: int = 115200):
+        self.port = port
+        self.baud = baud
+        self.last_line = ""
+        self._ser = None
+        if port:
+            import serial  # pyserial; only needed when an Arduino is attached
+            self._ser = serial.Serial(port, baud, timeout=1)
+
+    def send(self, profile: ArmProfile, emotion: str) -> str:
+        line = (f"ARM {profile.period_s:.3f} {profile.amplitude:.3f} "
+                f"{profile.phase_offset_deg:.1f} {emotion}")
+        self.last_line = line
+        if self._ser is not None:
+            self._ser.write((line + "\n").encode())
+        return line
+
+    def close(self) -> None:
+        if self._ser is not None:
+            self._ser.close()
+            self._ser = None
